+// Engine glTF texture cache hook: consult before decoding or uploading.
+static GltfTextureResolver gltfTextureResolver = NULL;
+static void *gltfTextureResolverUserData = NULL;
+void SetGltfTextureResolver(GltfTextureResolver resolver, void *userData)
+{
+    gltfTextureResolver = resolver;
+    gltfTextureResolverUserData = userData;
+}
+typedef struct GltfImageLoadContext { cgltf_image *image; const char *directory; } GltfImageLoadContext;
+static Image LoadGltfResolverImage(void *context)
+{
+    GltfImageLoadContext *source = (GltfImageLoadContext *)context;
+    return LoadImageFromCgltfImage(source->image, source->directory);
+}
+static Texture2D ResolveGltfTexture(cgltf_data *data, cgltf_image *image,
+    const char *directory, const char *modelPath, int map)
+{
+    GltfImageLoadContext context = { image, directory };
+    return gltfTextureResolver(modelPath, image->uri, (int)(image - data->images), map,
+        LoadGltfResolverImage, &context, gltfTextureResolverUserData);
+}
+
