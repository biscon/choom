+// Set one-pole low-pass cutoff for an audio buffer
+void SetAudioBufferLowPassFilter(AudioBuffer *buffer, float cutoffFrequency)
+{
+    if (buffer != NULL)
+    {
+        ma_mutex_lock(&AUDIO.System.lock);
+        float nyquist = (float)AUDIO.System.device.sampleRate*0.5f;
+        if (!isfinite(cutoffFrequency) || cutoffFrequency >= nyquist) buffer->lowPassAlpha = 1.0f;
+        else
+        {
+            if (cutoffFrequency < 20.0f) cutoffFrequency = 20.0f;
+            buffer->lowPassAlpha = 1.0f - expf(-6.283185307179586f*cutoffFrequency/(float)AUDIO.System.device.sampleRate);
+            if (buffer->lowPassAlpha < 0.0f) buffer->lowPassAlpha = 0.0f;
+            else if (buffer->lowPassAlpha > 1.0f) buffer->lowPassAlpha = 1.0f;
+        }
+        ma_mutex_unlock(&AUDIO.System.lock);
+    }
+}
